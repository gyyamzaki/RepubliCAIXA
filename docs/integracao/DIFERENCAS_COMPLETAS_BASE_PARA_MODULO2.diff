+$usuarioId = is_array($usuario)
+    ? (int) ($usuario['id'] ?? 0)
+    : 0;
+
+// BUSCAR O PAPEL DO USUÁRIO NA REPÚBLICA
+$consultaMembro = \App\Core\Database::connection()->prepare(
+    'SELECT id, role
+     FROM republic_members
+     WHERE republic_id = :republica
+       AND user_id = :usuario
+       AND active = 1
+     LIMIT 1'
+);
