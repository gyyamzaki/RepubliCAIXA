--- /mnt/data/integracao_rep/base/app/Services/ExpenseRateio.php	1970-01-01 00:00:00.000000000 +0000
+++ /mnt/data/integracao_rep/stage3/app/Services/ExpenseRateio.php	2026-11-15 01:33:25.037144859 +0000
@@ -0,0 +1,187 @@
+<?php
+
+namespace App\Services;
+
+use InvalidArgumentException;
+
+final class ExpenseRateio
+{
+    // Converte reais para centavos
+    public static function centavos(string $texto): int
+    {
+        $texto = str_replace(',', '.', trim($texto));
+
+        if (!preg_match('/^\d{1,8}(?:\.\d{1,2})?$/D', $texto)) {
+            throw new InvalidArgumentException(
+                'Informe um valor válido. Ex.: 300.00'
+            );
+        }
+
+        [$inteiro, $decimais] = array_pad(
+            explode('.', $texto, 2), 2, '0'
+        );
+
+        return (int) $inteiro * 100
+            + (int) str_pad($decimais, 2, '0');
+    }
+
+    // Calcula o rateio escolhido
+    public static function calcular(
+        string $tipo,
+        int $totalCentavos,
+        array $moradores,
+        array $valores = []
+    ): array {
+
+        $moradores = array_values(
+            array_unique(array_map('intval', $moradores))
+        );
+
+        $quantidade = count($moradores);
+
+        if (
+            $totalCentavos <= 0 ||
+            $quantidade === 0 ||
+            count(array_filter($moradores, fn($id) => $id <= 0)) > 0
+        ) {
+            throw new InvalidArgumentException(
+                'Informe valor e moradores válidos.'
+            );
+        }
+
+        $partes = [];
+
+        // RATEIO IGUALITÁRIO
+        if ($tipo === 'equal') {
+
+            $base = intdiv($totalCentavos, $quantidade);
+            $resto = $totalCentavos % $quantidade;
+
+            foreach ($moradores as $indice => $id) {
+                $partes[$id] = [
+                    'centavos' => $base + (
+                        $indice < $resto ? 1 : 0
+                    ),
+                    'percentual' => null
+                ];
+            }
+
+        // RATEIO PERSONALIZADO
+        } elseif ($tipo === 'custom') {
+
+            $soma = 0;
+
+            foreach ($moradores as $id) {
+
+                $centavos = self::centavos(
+                    (string) ($valores[$id] ?? '')
+                );
+
+                $soma += $centavos;
+
+                $partes[$id] = [
+                    'centavos' => $centavos,
+                    'percentual' => null
+                ];
+            }
+
+            if ($soma !== $totalCentavos) {
+                throw new InvalidArgumentException(
+                    'Os valores devem somar o total da despesa.'
+                );
+            }
+
+        // RATEIO PERCENTUAL
+        } elseif ($tipo === 'percentage') {
+
+            $somaPercentual = 0;
+            $somaCentavos = 0;
+            $restos = [];
+
+            foreach ($moradores as $id) {
+
+                $texto = str_replace(
+                    ',',
+                    '.',
+                    trim((string) ($valores[$id] ?? ''))
+                );
+
+                if (!preg_match(
+                    '/^\d{1,3}(?:\.\d{1,2})?$/D',
+                    $texto
+                )) {
+                    throw new InvalidArgumentException(
+                        'Informe percentuais com até 2 casas decimais.'
+                    );
+                }
+
+                [$inteiro, $decimal] = array_pad(
+                    explode('.', $texto, 2),
+                    2,
+                    '0'
+                );
+
+                $percentual = (int) $inteiro * 100
+                    + (int) str_pad($decimal, 2, '0');
+
+                if ($percentual > 10000) {
+                    throw new InvalidArgumentException(
+                        'Percentual maior que 100%.'
+                    );
+                }
+
+                $produto = $totalCentavos * $percentual;
+                $centavos = intdiv($produto, 10000);
+
+                $partes[$id] = [
+                    'centavos' => $centavos,
+                    'percentual' => number_format(
+                        $percentual / 100, 2, '.', ''
+                    )
+                ];
+
+                $restos[$id] = $produto % 10000;
+
+                $somaCentavos += $centavos;
+                $somaPercentual += $percentual;
+            }
+
+            if ($somaPercentual !== 10000) {
+                throw new InvalidArgumentException(
+                    'A soma dos percentuais deve ser 100%.'
+                );
+            }
+
+            // Distribui centavos restantes
+            arsort($restos, SORT_NUMERIC);
+
+            $faltam = $totalCentavos - $somaCentavos;
+
+            foreach (array_keys($restos) as $id) {
+                if ($faltam <= 0) {
+                    break;
+                }
+
+                $partes[$id]['centavos']++;
+                $faltam--;
+            }
+
+        } else {
+
+            throw new InvalidArgumentException(
+                'Tipo de rateio inválido.'
+            );
+        }
+
+        // Verifica se todos recebem um valor positivo
+        foreach ($partes as $parte) {
+            if ($parte['centavos'] < 1) {
+                throw new InvalidArgumentException(
+                    'Cada morador deve pagar pelo menos R$ 0,01.'
+                );
+            }
+        }
+
+        return $partes;
+    }
+}
diff -ruN '--exclude=.git' /mnt/data/integracao_rep/base/app/Services/FinanceInput.php /mnt/data/integracao_rep/stage3/app/Services/FinanceInput.php
--- /mnt/data/integracao_rep/base/app/Services/FinanceInput.php	1970-01-01 00:00:00.000000000 +0000
+++ /mnt/data/integracao_rep/stage3/app/Services/FinanceInput.php	2026-11-15 01:34:39.710853321 +0000
@@ -0,0 +1,78 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Services;
+
+use DateTimeImmutable;
+use InvalidArgumentException;
+
+final class FinanceInput
+{
+    public static function text(mixed $value): string
+    {
+        if (!is_string($value)) {
+            throw new InvalidArgumentException('Formato de campo inválido.');
+        }
+        return trim($value);
+    }
+
+    public static function month(mixed $value): array
+    {
+        $month = self::text($value);
+        if (!preg_match('/\A(?:20\d{2}|2100)-(?:0[1-9]|1[0-2])\z/', $month)) {
+            throw new InvalidArgumentException('Selecione um mês entre 2000 e 2100.');
+        }
+        $date = new DateTimeImmutable($month . '-01');
+        return [$month, $date->format('Y-m-d'), $date->modify('+1 month')->format('Y-m-d')];
+    }
+
+    public static function transaction(array $input): array
+    {
+        $type = self::text($input['type'] ?? '');
+        if (!in_array($type, ['income', 'expense'], true)) {
+            throw new InvalidArgumentException('Selecione entrada ou saída.');
+        }
+        $amount = ExpenseRateio::centavos(self::text($input['amount'] ?? ''));
+        if ($amount <= 0) {
+            throw new InvalidArgumentException('Informe um valor maior que zero.');
+        }
+        $description = self::text($input['description'] ?? '');
+        if (mb_strlen($description, 'UTF-8') < 3 || mb_strlen($description, 'UTF-8') > 255) {
+            throw new InvalidArgumentException('A descrição deve ter entre 3 e 255 caracteres.');
+        }
+        $day = self::text($input['transaction_date'] ?? '');
+        $date = DateTimeImmutable::createFromFormat('!Y-m-d', $day);
+        if (!$date || $date->format('Y-m-d') !== $day || $day < '2000-01-01' || $day > date('Y-m-d')) {
+            throw new InvalidArgumentException('Informe uma data válida, a partir de 2000 e até hoje. Registre apenas movimentos realizados.');
+        }
+        return compact('type', 'amount', 'description', 'day');
+    }
+
+    // Valores DECIMAL do banco são strings; todos os cálculos monetários usam inteiros.
+    public static function cents(string $decimal): int
+    {
+        if (!preg_match('/\A(-?)(\d{1,14})(?:\.(\d{1,2}))?\z/', $decimal, $parts)) {
+            throw new InvalidArgumentException('Valor monetário inválido no banco.');
+        }
+        $cents = (int) $parts[2] * 100 + (int) str_pad($parts[3] ?? '', 2, '0');
+        return ($parts[1] === '-' ? -1 : 1) * $cents;
+    }
+
+    public static function decimal(int $cents): string
+    {
+        return ($cents < 0 ? '-' : '') . intdiv(abs($cents), 100) . '.' . str_pad((string) (abs($cents) % 100), 2, '0', STR_PAD_LEFT);
+    }
+
+    public static function money(int $cents): string
+    {
+        $integer = preg_replace('/\B(?=(\d{3})+(?!\d))/', '.', (string) intdiv(abs($cents), 100));
+        return ($cents < 0 ? '- ' : '') . 'R$ ' . $integer . ',' . str_pad((string) (abs($cents) % 100), 2, '0', STR_PAD_LEFT);
+    }
+
+    public static function csvText(string $text): string
+    {
+        // Evita fórmulas ao abrir texto controlado pelo usuário em planilhas.
+        return preg_match('/\A[\s\x{FEFF}]*[=+@-]/u', $text) ? "'" . $text : $text;
+    }
+}
diff -ruN '--exclude=.git' /mnt/data/integracao_rep/base/app/Services/FinanceService.php /mnt/data/integracao_rep/stage3/app/Services/FinanceService.php
--- /mnt/data/integracao_rep/base/app/Services/FinanceService.php	1970-01-01 00:00:00.000000000 +0000
+++ /mnt/data/integracao_rep/stage3/app/Services/FinanceService.php	2026-11-15 01:34:39.713373022 +0000
@@ -0,0 +1,153 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Services;
+
+use InvalidArgumentException;
+use PDO;
+use Throwable;
+
+final class FinanceService
+{
+    public function __construct(private PDO $db) {}
+
+    public function context(int $userId): ?array
+    {
+        // Mesma república utilizada pelo módulo de despesas: primeira ativa por ID.
+        $query = $this->db->prepare('SELECT r.id, r.name, rm.role, rm.id AS member_id
+            FROM republic_members rm JOIN republics r ON r.id = rm.republic_id
+            JOIN users u ON u.id = rm.user_id
+            WHERE rm.user_id = :user AND rm.active = 1 AND r.active = 1 AND u.active = 1
+            ORDER BY r.id LIMIT 1');
+        $query->execute(['user' => $userId]);
+        return $query->fetch() ?: null;
+    }
+
+    public function cashSummary(int $republic, string $start, string $end): array
+    {
+        $query = $this->db->prepare("SELECT
+            COALESCE(SUM(CASE WHEN type = 'income' THEN amount ELSE -amount END), 0) balance,
+            COALESCE(SUM(CASE WHEN transaction_date < :opening THEN CASE WHEN type = 'income' THEN amount ELSE -amount END ELSE 0 END), 0) opening,
+            COALESCE(SUM(CASE WHEN transaction_date >= :income_start AND transaction_date < :income_end AND type = 'income' THEN amount ELSE 0 END), 0) income,
+            COALESCE(SUM(CASE WHEN transaction_date >= :expense_start AND transaction_date < :expense_end AND type = 'expense' THEN amount ELSE 0 END), 0) expense
+            FROM cash_transactions WHERE republic_id = :republic");
+        $query->execute(['opening' => $start, 'income_start' => $start, 'income_end' => $end,
+            'expense_start' => $start, 'expense_end' => $end, 'republic' => $republic]);
+        $result = array_map(fn($value) => FinanceInput::cents((string) $value), $query->fetch());
+        $result['closing'] = $result['opening'] + $result['income'] - $result['expense'];
+        return $result;
+    }
+
+    public function cashRows(int $republic, string $start, string $end): array
+    {
+        $query = $this->db->prepare('SELECT c.id, c.type, c.amount, c.description, c.transaction_date, u.name AS author
+            FROM cash_transactions c JOIN users u ON u.id = c.created_by
+            WHERE c.republic_id = :republic AND c.transaction_date >= :start AND c.transaction_date < :end
+            ORDER BY c.transaction_date, c.id');
+        $query->execute(['republic' => $republic, 'start' => $start, 'end' => $end]);
+        $rows = $query->fetchAll();
+        foreach ($rows as &$row) {
+            $row['cents'] = FinanceInput::cents($row['amount']);
+        }
+        return $rows;
+    }
+
+    public function addCash(int $republic, int $userId, array $movement): int
+    {
+        $this->db->beginTransaction();
+        try {
+            // Serializa os lançamentos da república, inclusive quando o caixa está vazio.
+            $lock = $this->db->prepare('SELECT id FROM republics WHERE id = :id AND active = 1 FOR UPDATE');
+            $lock->execute(['id' => $republic]);
+            if (!$lock->fetchColumn()) {
+                throw new InvalidArgumentException('República indisponível.');
+            }
+            $permission = $this->db->prepare("SELECT rm.id FROM republic_members rm JOIN users u ON u.id = rm.user_id
+                WHERE rm.republic_id = :republic AND rm.user_id = :user AND rm.active = 1
+                AND rm.role = 'admin' AND u.active = 1 FOR UPDATE");
+            $permission->execute(['republic' => $republic, 'user' => $userId]);
+            if (!$permission->fetchColumn()) {
+                throw new InvalidArgumentException('Apenas administradores ativos podem movimentar a reserva.');
+            }
+            $insert = $this->db->prepare('INSERT INTO cash_transactions
+                (republic_id, created_by, type, amount, description, transaction_date)
+                VALUES (:republic, :user, :type, :amount, :description, :day)');
+            $insert->execute(['republic' => $republic, 'user' => $userId, 'type' => $movement['type'],
+                'amount' => FinanceInput::decimal($movement['amount']), 'description' => $movement['description'], 'day' => $movement['day']]);
+            $id = (int) $this->db->lastInsertId();
+
+            // Uma saída retroativa também não pode tornar negativo um saldo histórico.
+            $history = $this->db->prepare('SELECT type, amount FROM cash_transactions
+                WHERE republic_id = :republic ORDER BY transaction_date, id FOR UPDATE');
+            $history->execute(['republic' => $republic]);
+            $balance = 0;
+            while ($row = $history->fetch()) {
+                $amount = FinanceInput::cents($row['amount']);
+                $balance += $row['type'] === 'income' ? $amount : -$amount;
+                if ($balance < 0) {
+                    throw new InvalidArgumentException('Saldo insuficiente. O movimento deixaria a reserva negativa nessa data ou em uma data posterior.');
+                }
+            }
+            $this->db->commit();
+            return $id;
+        } catch (Throwable $error) {
+            if ($this->db->inTransaction()) {
+                $this->db->rollBack();
+            }
+            throw $error;
+        }
+    }
+
+    public function expenses(int $republic, ?string $start = null, ?string $end = null): array
+    {
+        // Agrega pagamentos por parcela antes de juntar às despesas: evita multiplicar totais.
+        // status=paid preserva a compatibilidade com parcelas quitadas pela base recebida.
+        $sql = "SELECT e.id, e.title, e.expense_date, e.due_date, e.total_amount,
+            COALESCE(c.name, 'Sem categoria') AS category,
+            COALESCE(SUM(LEAST(s.amount_due, GREATEST(0,
+                CASE WHEN s.status = 'paid' THEN s.amount_due ELSE COALESCE(p.confirmed, 0) END))), 0) AS paid
+            FROM expenses e LEFT JOIN expense_categories c ON c.id = e.category_id
+            LEFT JOIN expense_shares s ON s.expense_id = e.id
+            LEFT JOIN (SELECT expense_share_id, SUM(amount) confirmed FROM payments
+                WHERE status = 'confirmed' GROUP BY expense_share_id) p ON p.expense_share_id = s.id
+            WHERE e.republic_id = :republic";
+        $params = ['republic' => $republic];
+        if ($start !== null && $end !== null) {
+            $sql .= ' AND e.expense_date >= :start AND e.expense_date < :end';
+            $params += ['start' => $start, 'end' => $end];
+        }
+        $sql .= ' GROUP BY e.id, e.title, e.expense_date, e.due_date, e.total_amount, c.name ORDER BY e.expense_date, e.id';
+        $query = $this->db->prepare($sql);
+        $query->execute($params);
+        $rows = $query->fetchAll();
+        foreach ($rows as &$row) {
+            $row['total'] = FinanceInput::cents($row['total_amount']);
+            $row['paid'] = min($row['total'], max(0, FinanceInput::cents($row['paid'])));
+            $row['pending'] = max(0, $row['total'] - $row['paid']);
+        }
+        return $rows;
+    }
+
+    public function residentTotals(int $republic, string $start, string $end): array
+    {
+        $query = $this->db->prepare("SELECT u.name, rm.id AS member_id,
+            SUM(s.amount_due) total,
+            SUM(LEAST(s.amount_due, GREATEST(0, CASE WHEN s.status = 'paid' THEN s.amount_due ELSE COALESCE(p.confirmed, 0) END))) paid
+            FROM expense_shares s JOIN expenses e ON e.id = s.expense_id
+            JOIN republic_members rm ON rm.id = s.member_id JOIN users u ON u.id = rm.user_id
+            LEFT JOIN (SELECT expense_share_id, SUM(amount) confirmed FROM payments
+                WHERE status = 'confirmed' GROUP BY expense_share_id) p ON p.expense_share_id = s.id
+            WHERE e.republic_id = :republic AND rm.republic_id = :membership_republic
+            AND e.expense_date >= :start AND e.expense_date < :end
+            GROUP BY rm.id, u.name ORDER BY u.name, rm.id");
+        $query->execute(['republic' => $republic, 'membership_republic' => $republic, 'start' => $start, 'end' => $end]);
+        $rows = $query->fetchAll();
+        foreach ($rows as &$row) {
+            $row['total'] = FinanceInput::cents($row['total']);
+            $row['paid'] = FinanceInput::cents($row['paid']);
+            $row['pending'] = $row['total'] - $row['paid'];
+        }
+        return $rows;
+    }
+}
