diff -ruN '--exclude=.git' /mnt/data/integracao_rep/base/app/Controllers/ExpenseController.php /mnt/data/integracao_rep/stage3/app/Controllers/ExpenseController.php
--- /mnt/data/integracao_rep/base/app/Controllers/ExpenseController.php	1970-01-01 00:00:00.000000000 +0000
