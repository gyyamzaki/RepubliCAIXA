+<?php
+
+namespace App\Controllers;
+
+use App\Core\Database;
+use App\Core\Session;
+use App\Services\ExpenseRateio;
+use InvalidArgumentException;
+use PDO;
+use Throwable;
+
+final class ExpenseEditController
+{
+    public function edit(): void
+    {
+        // VERIFICAR LOGIN
+        $usuario = Session::get('user');
+
+        if (!is_array($usuario) || empty($usuario['id'])) {
+            header('Location: /login');
+            exit;
+        }
+
+        // IDENTIFICAR A DESPESA
+        $id = filter_input(
+            INPUT_GET,
+            'id',
+            FILTER_VALIDATE_INT,
+            ['options' => ['min_range' => 1]]
+        );
+
+        if (!$id) {
+            http_response_code(404);
+            exit('Despesa não encontrada.');
+        }
+
+        $db = Database::connection();
+
+        // VERIFICAR A REPÚBLICA DO USUÁRIO
+        $consulta = $db->prepare(
+            'SELECT e.*, rm.role
+             FROM expenses e
+             JOIN republic_members rm
+               ON rm.republic_id = e.republic_id
+             JOIN republics r
+               ON r.id = e.republic_id
+             WHERE e.id = :id
+               AND rm.user_id = :usuario
+               AND rm.active = 1
+               AND r.active = 1
+             LIMIT 1'
+        );
+
+        $consulta->execute([
+            'id' => $id,
+            'usuario' => (int) $usuario['id']
+        ]);
+
+        $despesa = $consulta->fetch(PDO::FETCH_ASSOC);
+
+        if (!$despesa) {
+            http_response_code(404);
+            exit('Despesa não encontrada nesta república.');
+        }
+
+        // VERIFICAR PERMISSÃO DE EDIÇÃO
+        if (
+            (int) $despesa['created_by'] !==
+                (int) $usuario['id']
+            &&
+            $despesa['role'] !== 'admin'
+        ) {
+            http_response_code(403);
+            exit('Você não tem permissão para editar.');
+        }
+
+        // BUSCAR CATEGORIAS
+        $categorias = $db->query(
+            'SELECT id, name
+             FROM expense_categories
+             WHERE active = 1
+             ORDER BY name'
+        )->fetchAll(PDO::FETCH_ASSOC);
+
+        // BUSCAR MORADORES
+        $consulta = $db->prepare(
+            'SELECT rm.id, u.name
+             FROM republic_members rm
+             JOIN users u ON u.id = rm.user_id
+             WHERE rm.republic_id = :republica
+               AND rm.active = 1
+               AND u.active = 1
+             ORDER BY u.name'
+        );
+
+        $consulta->execute([
+            'republica' => (int) $despesa['republic_id']
+        ]);
+
+        $moradores = $consulta->fetchAll(
+            PDO::FETCH_ASSOC
+        );
+
+        // BUSCAR RATEIO ATUAL
+        $consulta = $db->prepare(
+            'SELECT member_id, amount_due, percentage, status
+             FROM expense_shares
+             WHERE expense_id = :id
+             ORDER BY member_id'
+        );
+
+        $consulta->execute(['id' => $id]);
+
+        $partesAtuais = $consulta->fetchAll(
+            PDO::FETCH_ASSOC
+        );
+
+        // PREPARAR CAMPOS DO FORMULÁRIO
+        $dados = $despesa;
+        $selecionados = [];
+        $valoresAtuais = [];
+
+        foreach ($partesAtuais as $parte) {
+
+            $moradorId = (int) $parte['member_id'];
+
+            $selecionados[] = $moradorId;
+
+            if ($despesa['split_type'] === 'percentage') {
+
+                $valoresAtuais[$moradorId] =
+                    $parte['percentage'];
+
+            } elseif ($despesa['split_type'] === 'custom') {
+
+                $valoresAtuais[$moradorId] =
+                    $parte['amount_due'];
+            }
+        }
+
+        // VERIFICAR SE EXISTEM PAGAMENTOS
+        $consulta = $db->prepare(
+            'SELECT COUNT(*)
+             FROM payments p
+             JOIN expense_shares s
+               ON s.id = p.expense_share_id
+             WHERE s.expense_id = :id'
+        );
+
+        $consulta->execute(['id' => $id]);
+
+        $temPagamentos =
+            (int) $consulta->fetchColumn() > 0;
+
+        $temPartePaga = false;
+
+        foreach ($partesAtuais as $parte) {
+
+            if ($parte['status'] === 'paid') {
+                $temPartePaga = true;
+                break;
+            }
+        }
+
+        $bloqueada = $temPagamentos || $temPartePaga;
+
+        // TOKEN DE SEGURANÇA
+        $csrf = Session::get('csrf_despesas');
+
+        if (!is_string($csrf) || $csrf === '') {
+
+            $csrf = bin2hex(random_bytes(32));
+
+            Session::set('csrf_despesas', $csrf);
+        }
+
+        $erros = [];
+
+        // PROCESSAR ALTERAÇÕES
+        if ($_SERVER['REQUEST_METHOD'] === 'POST') {
+
+            if (
+                !is_string($_POST['_csrf'] ?? null)
+                ||
+                !hash_equals($csrf, $_POST['_csrf'])
+            ) {
+                http_response_code(403);
+                exit('Formulário inválido.');
+            }
+
+            $dados = $_POST;
+
+            $valoresAtuais = is_array(
+                $_POST['values'] ?? null
+            ) ? $_POST['values'] : [];
+
+            try {
+
+                // BLOQUEAR EDIÇÃO COM PAGAMENTOS
+                if ($bloqueada) {
+
+                    throw new InvalidArgumentException(
+                        'Esta despesa possui pagamentos e não pode ser editada.'
+                    );
+                }
+
+                // MORADORES SELECIONADOS
+                $lista = $_POST['members'] ?? [];
+
+                if (!is_array($lista)) {
+                    throw new InvalidArgumentException(
+                        'Moradores inválidos.'
+                    );
+                }
+
+                $selecionados = array_values(
+                    array_unique(
+                        array_map('intval', $lista)
+                    )
+                );
+
+                // DADOS DA DESPESA
+                $titulo = trim(
+                    (string) ($_POST['title'] ?? '')
+                );
+
+                $descricao = trim(
+                    (string) ($_POST['description'] ?? '')
+                );
+
+                $categoria = (int) (
+                    $_POST['category_id'] ?? 0
+                );
+
+                $valorTexto = (string) (
+                    $_POST['total_amount'] ?? ''
+                );
+
+                $data = (string) (
+                    $_POST['expense_date'] ?? ''
+                );
+
+                $vencimento = (string) (
+                    $_POST['due_date'] ?? ''
+                );
+
+                $tipo = (string) (
+                    $_POST['split_type'] ?? 'equal'
+                );
+
+                // VALIDAR NOME
+                $tamanho = preg_match_all(
+                    '/./us',
+                    $titulo
+                );
+
+                if (
+                    $tamanho === false ||
+                    $tamanho < 2 ||
+                    $tamanho > 150
+                ) {
+                    throw new InvalidArgumentException(
+                        'Informe um nome de 2 a 150 caracteres.'
+                    );
+                }
+
+                if (strlen($descricao) > 5000) {
+                    throw new InvalidArgumentException(
+                        'Descrição muito longa.'
+                    );
+                }
+
+                // CONVERTER VALOR
+                $centavos = ExpenseRateio::centavos(
+                    $valorTexto
+                );
+
+                if ($centavos <= 0) {
+                    throw new InvalidArgumentException(
+                        'O valor deve ser maior que zero.'
+                    );
+                }
+
+                // VALIDAR CATEGORIA
+                $categoriasValidas = array_map(
+                    'intval',
+                    array_column($categorias, 'id')
+                );
+
+                if (!in_array(
+                    $categoria,
+                    $categoriasValidas,
+                    true
+                )) {
+                    throw new InvalidArgumentException(
+                        'Escolha uma categoria válida.'
+                    );
+                }
+
+                // VALIDAR DATAS
+                foreach (
+                    [$data, $vencimento]
+                    as $indice => $campo
+                ) {
+
+                    if ($indice === 1 && $campo === '') {
+                        continue;
+                    }
+
+                    if (!preg_match(
+                        '/^\d{4}-\d{2}-\d{2}$/D',
+                        $campo
+                    )) {
+                        throw new InvalidArgumentException(
+                            'Informe datas válidas.'
+                        );
+                    }
+
+                    [$ano, $mes, $dia] = array_map(
+                        'intval',
+                        explode('-', $campo)
+                    );
+
+                    if (!checkdate($mes, $dia, $ano)) {
+                        throw new InvalidArgumentException(
+                            'Informe datas válidas.'
+                        );
+                    }
+                }
+
+                // VALIDAR MORADORES
+                $permitidos = array_map(
+                    'intval',
+                    array_column($moradores, 'id')
+                );
+
+                if (
+                    !$selecionados ||
+                    array_diff($selecionados, $permitidos)
+                ) {
+                    throw new InvalidArgumentException(
+                        'Selecione moradores válidos.'
+                    );
+                }
+
+                // VALIDAR TIPO DE RATEIO
+                if (!in_array(
+                    $tipo,
+                    ['equal', 'percentage', 'custom'],
+                    true
+                )) {
+                    throw new InvalidArgumentException(
+                        'Tipo de rateio inválido.'
+                    );
+                }
+
+                // VALIDAR VALORES DOS MORADORES
+                if ($tipo !== 'equal') {
+
+                    foreach ($selecionados as $moradorId) {
+
+                        if (
+                            !isset($valoresAtuais[$moradorId])
+                            ||
+                            !is_scalar(
+                                $valoresAtuais[$moradorId]
+                            )
+                        ) {
+                            throw new InvalidArgumentException(
+                                'Preencha os valores do rateio.'
+                            );
+                        }
+                    }
+                }
+
+                // RECALCULAR RATEIO
+                $partes = ExpenseRateio::calcular(
+                    $tipo,
+                    $centavos,
+                    $selecionados,
+                    $valoresAtuais
+                );
+
+                // INICIAR TRANSAÇÃO
+                $db->beginTransaction();
+
+                // BLOQUEAR A DESPESA DURANTE A EDIÇÃO
+                $consulta = $db->prepare(
+                    'SELECT id
+                     FROM expenses
+                     WHERE id = :id
+                       AND republic_id = :republica
+                     FOR UPDATE'
+                );
+
+                $consulta->execute([
+                    'id' => $id,
+                    'republica' =>
+                        (int) $despesa['republic_id']
+                ]);
+
+                if (!$consulta->fetchColumn()) {
+                    throw new InvalidArgumentException(
+                        'Despesa não encontrada.'
+                    );
+                }
+
+                // CONFERIR AS PARTES DO RATEIO
+                $consulta = $db->prepare(
+                    'SELECT id, status
+                     FROM expense_shares
+                     WHERE expense_id = :id
+                     FOR UPDATE'
+                );
+
+                $consulta->execute(['id' => $id]);
+
+                $partesBloqueadas = $consulta->fetchAll(
+                    PDO::FETCH_ASSOC
+                );
+
+                foreach ($partesBloqueadas as $parte) {
+
+                    if ($parte['status'] === 'paid') {
+                        throw new InvalidArgumentException(
+                            'Não é possível editar uma despesa com pagamentos.'
+                        );
+                    }
+                }
+
+                // CONFERIR PAGAMENTOS NOVAMENTE
+                $consulta = $db->prepare(
+                    'SELECT COUNT(*)
+                     FROM payments p
+                     JOIN expense_shares s
+                       ON s.id = p.expense_share_id
+                     WHERE s.expense_id = :id'
+                );
+
+                $consulta->execute(['id' => $id]);
+
+                if (
+                    (int) $consulta->fetchColumn() > 0
+                ) {
+                    throw new InvalidArgumentException(
+                        'Não é possível editar uma despesa com pagamentos.'
+                    );
+                }
+
+                // ATUALIZAR A DESPESA
+                $consulta = $db->prepare(
+                    'UPDATE expenses
+                     SET title = :titulo,
+                         description = :descricao,
+                         category_id = :categoria,
+                         total_amount = :valor,
+                         expense_date = :data,
+                         due_date = :vencimento,
+                         split_type = :tipo
+                     WHERE id = :id'
+                );
+
+                $consulta->execute([
+                    'titulo' => $titulo,
+                    'descricao' => $descricao,
+                    'categoria' => $categoria,
+
+                    'valor' => number_format(
+                        $centavos / 100,
+                        2,
+                        '.',
+                        ''
+                    ),
+
+                    'data' => $data,
+
+                    'vencimento' => $vencimento !== ''
+                        ? $vencimento
+                        : null,
+
+                    'tipo' => $tipo,
+                    'id' => $id
+                ]);
+
+                // REMOVER RATEIO ANTERIOR
+                $consulta = $db->prepare(
+                    'DELETE FROM expense_shares
+                     WHERE expense_id = :id'
+                );
+
+                $consulta->execute(['id' => $id]);
+
+                // SALVAR NOVO RATEIO
+                $inserir = $db->prepare(
+                    'INSERT INTO expense_shares
+                    (
+                        expense_id,
+                        member_id,
+                        amount_due,
+                        percentage
+                    )
+                    VALUES
+                    (
+                        :despesa,
+                        :morador,
+                        :valor,
+                        :percentual
+                    )'
+                );
+
+                foreach ($partes as $moradorId => $parte) {
+
+                    $inserir->execute([
+                        'despesa' => $id,
+                        'morador' => (int) $moradorId,
+
+                        'valor' => number_format(
+                            $parte['centavos'] / 100,
+                            2,
+                            '.',
+                            ''
+                        ),
+
+                        'percentual' =>
+                            $parte['percentual']
+                    ]);
+                }
+
+                // CONFIRMAR ALTERAÇÕES
+                $db->commit();
+
+                header(
+                    'Location: /despesas',
+                    true,
+                    303
+                );
+
+                exit;
+
+            } catch (InvalidArgumentException $erro) {
+
+                if ($db->inTransaction()) {
+                    $db->rollBack();
+                }
+
+                $erros[] = $erro->getMessage();
+
+            } catch (Throwable $erro) {
+
+                if ($db->inTransaction()) {
+                    $db->rollBack();
+                }
+
+                error_log((string) $erro);
+
+                $erros[] =
+                    'Não foi possível atualizar a despesa.';
+            }
+        }
+
+        // ABRIR O FORMULÁRIO DE EDIÇÃO
+        require dirname(__DIR__)
+            . '/Views/expenses/edit.php';
+    }
+}
diff -ruN '--exclude=.git' /mnt/data/integracao_rep/base/app/Controllers/ExpensePaymentController.php /mnt/data/integracao_rep/stage3/app/Controllers/ExpensePaymentController.php
--- /mnt/data/integracao_rep/base/app/Controllers/ExpensePaymentController.php	1970-01-01 00:00:00.000000000 +0000
+++ /mnt/data/integracao_rep/stage3/app/Controllers/ExpensePaymentController.php	2026-11-15 01:33:25.034670314 +0000
@@ -0,0 +1,655 @@
+<?php
+
+namespace App\Controllers;
+
+use App\Core\Database;
+use App\Core\Session;
+use App\Services\ExpenseRateio;
+use InvalidArgumentException;
+use PDO;
+use Throwable;
+
+final class ExpensePaymentController
+{
+    private function usuarioId(): int
+    {
+        $usuario = Session::get('user');
+
+        if (!is_array($usuario) || empty($usuario['id'])) {
+            header('Location: /login');
+            exit;
+        }
+
+        return (int) $usuario['id'];
+    }
+
+    private function validarToken(): void
+    {
+        $esperado = Session::get('csrf_despesas');
+        $recebido = $_POST['_csrf'] ?? null;
+
+        if (
+            !is_string($esperado) ||
+            !is_string($recebido) ||
+            !hash_equals($esperado, $recebido)
+        ) {
+            http_response_code(403);
+            exit(
+                'Formulário inválido. Atualize a página e tente novamente.'
+            );
+        }
+    }
+
+    private function erro(
+        string $mensagem,
+        int $codigo = 422
+    ): void {
+        http_response_code($codigo);
+
+        echo '<!doctype html>';
+        echo '<html lang="pt-BR">';
+        echo '<meta charset="UTF-8">';
+        echo '<title>Pagamento</title>';
+
+        echo '<body style="font-family:Arial;padding:30px">';
+        echo '<h2>Não foi possível concluir a operação</h2>';
+
+        echo '<p>';
+        echo htmlspecialchars(
+            $mensagem,
+            ENT_QUOTES,
+            'UTF-8'
+        );
+        echo '</p>';
+
+        echo '<p><a href="/despesas">';
+        echo 'Voltar às despesas';
+        echo '</a></p></body></html>';
+
+        exit;
+    }
+
+    // REGISTRAR PAGAMENTO
+    public function store(): void
+    {
+        $usuarioId = $this->usuarioId();
+        $this->validarToken();
+
+        $shareId = filter_var(
+            $_POST['share_id'] ?? null,
+            FILTER_VALIDATE_INT
+        );
+
+        if (!$shareId || $shareId < 1) {
+            $this->erro('Selecione um morador válido.');
+        }
+
+        try {
+            $centavos = ExpenseRateio::centavos(
+                (string) ($_POST['amount'] ?? '')
+            );
+
+            if ($centavos < 1) {
+                throw new InvalidArgumentException(
+                    'O pagamento deve ser maior que zero.'
+                );
+            }
+        } catch (InvalidArgumentException $erro) {
+            $this->erro($erro->getMessage());
+        }
+
+        $db = Database::connection();
+
+        $comprovante = null;
+        $arquivoFisico = null;
+
+        try {
+            $db->beginTransaction();
+
+            // Verifica se o usuário pode registrar
+            // pagamento nesta parte da despesa.
+            $consulta = $db->prepare(
+                "SELECT
+                    s.id,
+                    s.expense_id,
+                    s.amount_due,
+                    s.status,
+                    e.republic_id,
+                    rm.role
+                 FROM expense_shares s
+                 JOIN expenses e
+                    ON e.id = s.expense_id
+                 JOIN republics r
+                    ON r.id = e.republic_id
+                 JOIN republic_members rm
+                    ON rm.republic_id = e.republic_id
+                 WHERE s.id = :parte
+                   AND rm.user_id = :usuario
+                   AND rm.active = 1
+                   AND r.active = 1
+                   AND (
+                       rm.role = 'admin'
+                       OR rm.id = s.member_id
+                   )
+                 LIMIT 1"
+            );
+
+            $consulta->execute([
+                'parte' => $shareId,
+                'usuario' => $usuarioId
+            ]);
+
+            $parte = $consulta->fetch(PDO::FETCH_ASSOC);
+
+            if (!$parte) {
+                throw new InvalidArgumentException(
+                    'Você não pode registrar este pagamento.'
+                );
+            }
+
+            // Protege a despesa durante o pagamento.
+            $trava = $db->prepare(
+                'SELECT id
+                 FROM expenses
+                 WHERE id = :id
+                 FOR UPDATE'
+            );
+
+            $trava->execute([
+                'id' => (int) $parte['expense_id']
+            ]);
+
+            $trava->fetchColumn();
+
+            $trava = $db->prepare(
+                'SELECT amount_due, status
+                 FROM expense_shares
+                 WHERE id = :id
+                 FOR UPDATE'
+            );
+
+            $trava->execute(['id' => $shareId]);
+
+            $parteAtual = $trava->fetch(PDO::FETCH_ASSOC);
+
+            if (
+                !$parteAtual ||
+                $parteAtual['status'] === 'paid'
+            ) {
+                throw new InvalidArgumentException(
+                    'Esta parte já está paga ou não existe.'
+                );
+            }
+
+            // Soma pagamentos pendentes e confirmados.
+            $consulta = $db->prepare(
+                "SELECT COALESCE(SUM(amount), 0)
+                 FROM payments
+                 WHERE expense_share_id = :id
+                   AND status IN (
+                       'pending',
+                       'confirmed'
+                   )"
+            );
+
+            $consulta->execute(['id' => $shareId]);
+
+            $comprometidos = ExpenseRateio::centavos(
+                (string) $consulta->fetchColumn()
+            );
+
+            $devido = ExpenseRateio::centavos(
+                (string) $parteAtual['amount_due']
+            );
+
+            $disponivel = $devido - $comprometidos;
+
+            if ($centavos > $disponivel) {
+                throw new InvalidArgumentException(
+                    'O valor excede o saldo disponível, considerando pagamentos pendentes.'
+                );
+            }
+
+            // COMPROVANTE OPCIONAL
+            if (isset($_FILES['proof'])) {
+                $upload = $_FILES['proof'];
+
+                if (
+                    !is_array($upload) ||
+                    is_array($upload['error'] ?? null)
+                ) {
+                    throw new InvalidArgumentException(
+                        'Arquivo de comprovante inválido.'
+                    );
+                }
+
+                if ($upload['error'] !== UPLOAD_ERR_NO_FILE) {
+
+                    if ($upload['error'] !== UPLOAD_ERR_OK) {
+                        throw new InvalidArgumentException(
+                            'Falha ao enviar o comprovante.'
+                        );
+                    }
+
+                    if (
+                        ($upload['size'] ?? 0) < 1 ||
+                        $upload['size'] > 5 * 1024 * 1024
+                    ) {
+                        throw new InvalidArgumentException(
+                            'O comprovante deve ter até 5 MB.'
+                        );
+                    }
+
+                    $temporario = (string) (
+                        $upload['tmp_name'] ?? ''
+                    );
+
+                    if (!is_uploaded_file($temporario)) {
+                        throw new InvalidArgumentException(
+                            'Comprovante inválido.'
+                        );
+                    }
+
+                    // Somente PDF, JPG e PNG.
+                    $tipos = [
+                        'application/pdf' => 'pdf',
+                        'image/jpeg' => 'jpg',
+                        'image/png' => 'png'
+                    ];
+
+                    $detector = new \finfo(
+                        FILEINFO_MIME_TYPE
+                    );
+
+                    $mime = $detector->file($temporario);
+
+                    if (!isset($tipos[$mime])) {
+                        throw new InvalidArgumentException(
+                            'Envie um PDF, JPG ou PNG.'
+                        );
+                    }
+
+                    // Pasta fora da área pública do site.
+                    $pasta = dirname(__DIR__, 2)
+                        . '/storage/payment-proofs';
+
+                    if (
+                        !is_dir($pasta) &&
+                        !mkdir($pasta, 0750, true) &&
+                        !is_dir($pasta)
+                    ) {
+                        throw new InvalidArgumentException(
+                            'Não foi possível criar a pasta de comprovantes.'
+                        );
+                    }
+
+                    $nome = bin2hex(random_bytes(16))
+                        . '.'
+                        . $tipos[$mime];
+
+                    $arquivoFisico = $pasta
+                        . '/'
+                        . $nome;
+
+                    if (!move_uploaded_file(
+                        $temporario,
+                        $arquivoFisico
+                    )) {
+                        throw new InvalidArgumentException(
+                            'Não foi possível salvar o comprovante.'
+                        );
+                    }
+
+                    $comprovante = $nome;
+                }
+            }
+
+            // REGISTRAR NO MYSQL
+            $consulta = $db->prepare(
+                "INSERT INTO payments
+                    (
+                        expense_share_id,
+                        amount,
+                        proof_path,
+                        status
+                    )
+                 VALUES
+                    (
+                        :parte,
+                        :valor,
+                        :comprovante,
+                        'pending'
+                    )"
+            );
+
+            $consulta->execute([
+                'parte' => $shareId,
+
+                'valor' => number_format(
+                    $centavos / 100,
+                    2,
+                    '.',
+                    ''
+                ),
+
+                'comprovante' => $comprovante
+            ]);
+
+            $db->commit();
+
+            header(
+                'Location: /despesas/detalhes?id='
+                . (int) $parte['expense_id']
+                . '&pagamento=registrado',
+                true,
+                303
+            );
+
+            exit;
+
+        } catch (Throwable $erro) {
+
+            if ($db->inTransaction()) {
+                $db->rollBack();
+            }
+
+            if (
+                $arquivoFisico !== null &&
+                is_file($arquivoFisico)
+            ) {
+                unlink($arquivoFisico);
+            }
+
+            if ($erro instanceof InvalidArgumentException) {
+                $this->erro($erro->getMessage());
+            }
+
+            error_log((string) $erro);
+
+            $this->erro(
+                'Erro interno ao registrar pagamento.',
+                500
+            );
+        }
+    }
+
+    // CONFIRMAR PAGAMENTO
+    public function confirm(): void
+    {
+        $usuarioId = $this->usuarioId();
+        $this->validarToken();
+
+        $paymentId = filter_var(
+            $_POST['payment_id'] ?? null,
+            FILTER_VALIDATE_INT
+        );
+
+        if (!$paymentId || $paymentId < 1) {
+            $this->erro('Pagamento inválido.');
+        }
+
+        $db = Database::connection();
+
+        try {
+            $db->beginTransaction();
+
+            // Somente administrador da república.
+            $consulta = $db->prepare(
+                "SELECT
+                    p.id,
+                    p.expense_share_id,
+                    s.expense_id
+                 FROM payments p
+                 JOIN expense_shares s
+                    ON s.id = p.expense_share_id
+                 JOIN expenses e
+                    ON e.id = s.expense_id
+                 JOIN republics r
+                    ON r.id = e.republic_id
+                 JOIN republic_members rm
+                    ON rm.republic_id = e.republic_id
+                 WHERE p.id = :pagamento
+                   AND rm.user_id = :usuario
+                   AND rm.active = 1
+                   AND rm.role = 'admin'
+                   AND r.active = 1
+                 LIMIT 1"
+            );
+
+            $consulta->execute([
+                'pagamento' => $paymentId,
+                'usuario' => $usuarioId
+            ]);
+
+            $alvo = $consulta->fetch(PDO::FETCH_ASSOC);
+
+            if (!$alvo) {
+                throw new InvalidArgumentException(
+                    'Somente um administrador pode confirmar este pagamento.'
+                );
+            }
+
+            $trava = $db->prepare(
+                'SELECT id
+                 FROM expenses
+                 WHERE id = :id
+                 FOR UPDATE'
+            );
+
+            $trava->execute([
+                'id' => (int) $alvo['expense_id']
+            ]);
+
+            $trava->fetchColumn();
+
+            $trava = $db->prepare(
+                'SELECT amount_due
+                 FROM expense_shares
+                 WHERE id = :id
+                 FOR UPDATE'
+            );
+
+            $trava->execute([
+                'id' => (int) $alvo['expense_share_id']
+            ]);
+
+            $devidoTexto = $trava->fetchColumn();
+
+            if ($devidoTexto === false) {
+                throw new InvalidArgumentException(
+                    'Parte da despesa não encontrada.'
+                );
+            }
+
+            // Verifica se ainda está pendente.
+            $consulta = $db->prepare(
+                'SELECT status
+                 FROM payments
+                 WHERE id = :id
+                 FOR UPDATE'
+            );
+
+            $consulta->execute(['id' => $paymentId]);
+
+            if ($consulta->fetchColumn() !== 'pending') {
+                throw new InvalidArgumentException(
+                    'Este pagamento não está aguardando confirmação.'
+                );
+            }
+
+            // Confirma o pagamento.
+            $consulta = $db->prepare(
+                "UPDATE payments
+                 SET status = 'confirmed'
+                 WHERE id = :id"
+            );
+
+            $consulta->execute(['id' => $paymentId]);
+
+            // Calcula o total confirmado.
+            $consulta = $db->prepare(
+                "SELECT COALESCE(SUM(amount), 0)
+                 FROM payments
+                 WHERE expense_share_id = :parte
+                   AND status = 'confirmed'"
+            );
+
+            $consulta->execute([
+                'parte' => (int) $alvo['expense_share_id']
+            ]);
+
+            $totalPago = ExpenseRateio::centavos(
+                (string) $consulta->fetchColumn()
+            );
+
+            $valorDevido = ExpenseRateio::centavos(
+                (string) $devidoTexto
+            );
+
+            // Marca o rateio como pago quando quitado.
+            if ($totalPago >= $valorDevido) {
+                $consulta = $db->prepare(
+                    "UPDATE expense_shares
+                     SET status = 'paid',
+                         paid_at = NOW()
+                     WHERE id = :id"
+                );
+
+                $consulta->execute([
+                    'id' => (int) $alvo['expense_share_id']
+                ]);
+            }
+
+            $db->commit();
+
+            header(
+                'Location: /despesas/detalhes?id='
+                . (int) $alvo['expense_id']
+                . '&pagamento=confirmado',
+                true,
+                303
+            );
+
+            exit;
+
+        } catch (Throwable $erro) {
+
+            if ($db->inTransaction()) {
+                $db->rollBack();
+            }
+
+            if ($erro instanceof InvalidArgumentException) {
+                $this->erro($erro->getMessage());
+            }
+
+            error_log((string) $erro);
+
+            $this->erro(
+                'Erro interno ao confirmar pagamento.',
+                500
+            );
+        }
+    }
+
+    // BAIXAR COMPROVANTE COM PERMISSÃO
+    public function proof(): void
+    {
+        $usuarioId = $this->usuarioId();
+
+        $paymentId = filter_input(
+            INPUT_GET,
+            'id',
+            FILTER_VALIDATE_INT
+        );
+
+        if (!$paymentId || $paymentId < 1) {
+            $this->erro(
+                'Comprovante não encontrado.',
+                404
+            );
+        }
+
+        $db = Database::connection();
+
+        $consulta = $db->prepare(
+            'SELECT p.proof_path
+             FROM payments p
+
+             JOIN expense_shares s
+                ON s.id = p.expense_share_id
+
+             JOIN expenses e
+                ON e.id = s.expense_id
+
+             JOIN republics r
+                ON r.id = e.republic_id
+
+             JOIN republic_members rm
+                ON rm.republic_id = e.republic_id
+
+             WHERE p.id = :pagamento
+               AND rm.user_id = :usuario
+               AND rm.active = 1
+               AND r.active = 1
+
+             LIMIT 1'
+        );
+
+        $consulta->execute([
+            'pagamento' => $paymentId,
+            'usuario' => $usuarioId
+        ]);
+
+        $nome = $consulta->fetchColumn();
+
+        if (
+            !$nome ||
+            !preg_match(
+                '/^[a-f0-9]{32}\.(pdf|jpg|png)$/D',
+                (string) $nome
+            )
+        ) {
+            $this->erro(
+                'Comprovante não encontrado.',
+                404
+            );
+        }
+
+        $arquivo = dirname(__DIR__, 2)
+            . '/storage/payment-proofs/'
+            . $nome;
+
+        if (!is_file($arquivo)) {
+            $this->erro(
+                'Arquivo de comprovante indisponível.',
+                404
+            );
+        }
+
+        $extensao = pathinfo(
+            $nome,
+            PATHINFO_EXTENSION
+        );
+
+        $tipos = [
+            'pdf' => 'application/pdf',
+            'jpg' => 'image/jpeg',
+            'png' => 'image/png'
+        ];
+
+        header('Content-Type: ' . $tipos[$extensao]);
+        header('X-Content-Type-Options: nosniff');
+
+        header(
+            'Content-Disposition: attachment; filename="comprovante.'
+            . $extensao
+            . '"'
+        );
+
+        header('Cache-Control: private, no-store');
+        header('Content-Length: ' . filesize($arquivo));
+
+        readfile($arquivo);
+        exit;
+    }
+}
