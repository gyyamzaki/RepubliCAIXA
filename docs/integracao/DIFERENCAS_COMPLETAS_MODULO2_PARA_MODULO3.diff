+.finance-filter .form-group { max-width: 240px; }
+.finance-cards { margin-bottom: 24px; }
+.finance-cards .card-label { font-weight: 600; font-size: .95rem; }
+.finance-cards .card-value { overflow-wrap: anywhere; }
+.finance-cards p { margin: 12px 0; font-size: .9rem; }
+.finance-note { border-left: 4px solid #0f766e; background: #eaf5f3; padding: 16px; border-radius: 4px; line-height: 1.6; }
+.finance-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
+.finance-section { margin-top: 24px; }
+.finance h2 { font-size: 1.25rem; }
+.finance-statement { margin: 0 0 16px; }
+.finance-statement div { display: flex; justify-content: space-between; gap: 24px; padding: 12px 0; border-bottom: 1px solid var(--color-border); }
+.finance-statement dd { margin: 0; font-weight: 600; white-space: nowrap; }
+.finance-total { font-weight: 700; }
+.finance-income { color: #11613c; }
+.finance-expense { color: #b91c1c; }
+.finance-warning { color: #92400e; }
+.finance-link { color: #0b655e; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
+.finance-bars { list-style: none; padding: 0; margin: 0; display: grid; gap: 18px; }
+.finance-bars li > div:first-child { display: flex; justify-content: space-between; gap: 12px; font-size: .9rem; }
+.finance-bars strong { white-space: nowrap; }
+.finance-track { background: #e8eef2; border-radius: 6px; overflow: hidden; height: 10px; margin-top: 6px; }
+.finance-track span { display: block; height: 100%; background: #0f766e; border-radius: inherit; }
+.finance-history { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 32px; }
+.finance-table-wrap { overflow-x: auto; margin: 16px 0; }
+.finance table { width: 100%; border-collapse: collapse; text-align: left; font-size: .93rem; }
+.finance th { color: #475569; background: #f8fafc; }
+.finance th, .finance td { padding: 14px 12px; border-bottom: 1px solid var(--color-border); vertical-align: top; }
+.finance td { overflow-wrap: anywhere; min-width: 100px; }
+.finance th { white-space: nowrap; }
+.finance-badge { display: inline-block; border: 1px solid #fecaca; background: #fff1f2; color: #991b1b; padding: 3px 7px; border-radius: 6px; font-size: .75rem; margin-top: 4px; }
+.finance-form { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; align-items: start; }
+.finance-wide { grid-column: 1 / -1; }
+.finance-help { margin-top: 20px; font-size: .9rem; line-height: 1.5; }
+.finance small { color: #475569; line-height: 1.5; }
+.finance-skip { position: absolute; top: -100px; left: 16px; padding: 12px; background: white; z-index: 200; color: #0b655e; }
+.finance-skip:focus { top: 8px; }
+.finance :focus-visible, .finance-skip:focus-visible { outline: 3px solid #2563eb; outline-offset: 3px; }
+.finance-sr { position: absolute; left: 0; top: 0; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
+@media (max-width: 1050px) { .finance-grid { grid-template-columns: 1fr; } .finance.card-grid, .finance .card-grid { grid-template-columns: 1fr; } }
+@media (max-width: 600px) { .finance-form, .finance-history { grid-template-columns: 1fr; } .finance .card { padding: 18px; } .finance-statement div { flex-wrap: wrap; gap: 8px; } .finance-filter { width: 100%; } .finance-actions { align-items: start; flex-direction: column; } }
+@media print {
+    .sidebar, .finance-filter, .finance-actions, .finance-skip, .finance form { display: none !important; }
+    .app-layout { display: block; }
+    .main-content { max-width: none; padding: 0; }
+    .finance .card { box-shadow: none; border: 0; padding: 0; }
+    .finance-note { background: white; border-left: 0; padding: 0; }
+    .finance-table-wrap { overflow: visible; }
+    .finance table { font-size: 9pt; }
+    .finance th, .finance td { min-width: 0; white-space: normal; padding: 7px 5px; }
+    .finance tr { break-inside: avoid; }
+    .finance h2 { break-after: avoid; }
+    .finance thead { display: table-header-group; }
+    .finance-section { margin-top: 20px; }
+    @page { size: A4 landscape; margin: 15mm; }
+}
